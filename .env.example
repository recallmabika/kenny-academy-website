# Copy this file to .env and fill in real values. Never commit .env.

# Flask
SECRET_KEY=change-this-to-a-long-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-before-going-live

# --- Outgoing email (SMTP) ---
# Used for: newsletter subscribe confirmations + admin notification,
# and contact-form notifications to the school.
# Example values for Gmail (use an App Password, not your normal password):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USE_TLS=true
# Example values for a generic provider / cPanel mail / SendGrid SMTP relay
# will look similar — check your provider's SMTP docs.
SMTP_HOST=
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Kenny Academy <no-reply@kennyacademy.co.zw>

# Where contact-form and new-subscriber notifications get sent.
# Falls back to the "email" field in data/settings.json if left blank.
MAIL_TO=
